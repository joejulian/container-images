{
  "name": "node-ansible-runner",
  "type": "build",
  "basePreference": "mirror",
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "context": "images/node-ansible-runner",
  "dockerfile": "Dockerfile",
  "image": "ghcr.io/joejulian/container-images/node-ansible-runner",
  "latestTag": "latest",
  "versionCommand": "python --version >/dev/null && node --version >/dev/null && printf 'python3.13.15-node22.23.2\\n'"
}
