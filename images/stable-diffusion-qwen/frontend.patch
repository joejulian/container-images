diff --git a/src/lib/draft.ts b/src/lib/draft.ts
new file mode 100644
index 0000000..b3a5f18
--- /dev/null
+++ b/src/lib/draft.ts
@@ -0,0 +1,115 @@
+import { createBlankForm } from "./form-defaults";
+import type { GenerationForm, ImageEntry, ImageTarget } from "./types";
+
+const COOKIE = "sdcpp-webui-draft";
+const IMAGE_KEYS: ImageTarget[] = ["init_image", "end_image", "mask_image", "control_image", "ip_adapter_image", "ref_images", "control_frames"];
+
+export interface Draft {
+    version: 1;
+    form: Partial<GenerationForm>;
+    tab: "image" | "video" | "settings";
+    mode: "image" | "video";
+    sections: Record<string, boolean>;
+    job?: { id: string };
+    catalog?: { recipeId: string; models: Record<string, string> } | null;
+}
+
+// Copy only fields known to this build, retaining new defaults after upgrades.
+function mergeKnown(defaults: any, saved: any): any {
+    if (Array.isArray(defaults)) return Array.isArray(saved) ? saved : defaults;
+    if (defaults !== null && typeof defaults === "object") {
+        return Object.fromEntries(Object.entries(defaults).map(([key, value]) => [key, mergeKnown(value, saved?.[key])]));
+    }
+    if (typeof saved === typeof defaults || ((typeof defaults === "number" && saved === "") || (defaults === "" && typeof saved === "number" && Number.isFinite(saved)))) return saved;
+    return defaults;
+}
+
+export function restoreForm(saved: Partial<GenerationForm>): GenerationForm {
+    const form = mergeKnown(createBlankForm(), saved) as GenerationForm;
+    for (const key of IMAGE_KEYS) (form as any)[key] = key === "ref_images" || key === "control_frames" ? [] : null;
+    return form;
+}
+
+function validImage(value: unknown): value is ImageEntry {
+    const image = value as ImageEntry;
+    return Boolean(image && typeof image.name === "string" && typeof image.type === "string" &&
+        typeof image.dataUrl === "string" && image.dataUrl.startsWith("data:"));
+}
+
+export class DraftStore {
+    private key: string;
+    private database?: Promise<IDBDatabase>;
+    private writes: Promise<void> = Promise.resolve();
+
+    constructor(baseUrl: string) {
+        let id = document.cookie.split(/;\s*/).find((item) => item.startsWith(`${COOKIE}=`))?.slice(COOKIE.length + 1);
+        if (!id || !/^[a-f0-9]{32}$/.test(id)) {
+            id = Array.from(crypto.getRandomValues(new Uint8Array(16)), (byte) => byte.toString(16).padStart(2, "0")).join("");
+        }
+        document.cookie = `${COOKIE}=${id}; Path=/; Max-Age=31536000; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`;
+        if (!document.cookie.includes(`${COOKIE}=${id}`)) throw new Error("Cookies are blocked.");
+        this.key = `sdcpp-webui-draft-v1:${id}:${location.pathname}:${baseUrl.trim()}`;
+    }
+
+    read(): Draft | null {
+        const saved = localStorage.getItem(this.key);
+        if (!saved) return null;
+        const draft = JSON.parse(saved);
+        if (draft?.version !== 1 || !draft.form || typeof draft.form !== "object") throw new Error("Saved draft has an unsupported format.");
+        return draft;
+    }
+
+    save(draft: Draft): void {
+        const form = { ...draft.form };
+        for (const key of IMAGE_KEYS) delete form[key];
+        // Synchronous writes preserve the last keystroke even on immediate reload.
+        localStorage.setItem(this.key, JSON.stringify({ ...draft, form }));
+    }
+
+    private open(): Promise<IDBDatabase> {
+        if (!this.database) this.database = new Promise((resolve, reject) => {
+            const request = indexedDB.open("sdcpp-webui-drafts", 1);
+            request.onupgradeneeded = () => request.result.createObjectStore("images");
+            request.onsuccess = () => resolve(request.result);
+            request.onerror = () => reject(request.error);
+            request.onblocked = () => reject(new Error("Image draft storage is blocked by another tab."));
+        });
+        return this.database;
+    }
+
+    async restoreImages(form: GenerationForm): Promise<void> {
+        const db = await this.open();
+        const images: any = await new Promise((resolve, reject) => {
+            const request = db.transaction("images").objectStore("images").get(this.key);
+            request.onsuccess = () => resolve(request.result);
+            request.onerror = () => reject(request.error);
+        });
+        if (!images) return;
+        for (const key of IMAGE_KEYS) {
+            const value = images[key];
+            (form as any)[key] = key === "ref_images" || key === "control_frames"
+                ? (Array.isArray(value) ? value.filter(validImage) : [])
+                : validImage(value) ? value : null;
+        }
+    }
+
+    saveImages(form: GenerationForm): Promise<void> {
+        const images = JSON.parse(JSON.stringify(Object.fromEntries(IMAGE_KEYS.map((key) => [key, form[key]]))));
+        const next = this.writes.catch(() => {}).then(async () => {
+            const db = await this.open();
+            await new Promise<void>((resolve, reject) => {
+                const transaction = db.transaction("images", "readwrite");
+                transaction.objectStore("images").put(images, this.key);
+                transaction.oncomplete = () => resolve();
+                transaction.onabort = () => reject(transaction.error || new Error("Image draft write aborted."));
+                transaction.onerror = () => reject(transaction.error);
+            });
+        });
+        this.writes = next;
+        return next;
+    }
+}
+
+export function imageDraft(form: GenerationForm): unknown[] {
+    return IMAGE_KEYS.map((key) => form[key]);
+}
