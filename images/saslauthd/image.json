{
  "name": "saslauthd",
  "type": "build",
  "basePreference": "alpine",
  "platforms": ["linux/amd64", "linux/arm64"],
  "context": "images/saslauthd",
  "dockerfile": "Dockerfile",
  "image": "ghcr.io/joejulian/container-images/saslauthd",
  "versionCommand": "dpkg-query -W -f='${Version}\\n' sasl2-bin | sed -n '1s/+dfsg[0-9]*//p'"
}
