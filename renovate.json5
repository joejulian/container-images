{
  extends: [
    "config:recommended",
    ":rebaseStalePrs",
    ":separateMajorReleases",
  ],
  automergeType: "pr",
  platformAutomerge: false,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  rebaseWhen: "behind-base-branch",
  packageRules: [
    {
      // The patched library must match the server and ggml in this exact runtime.
      // Advance source, runtime, and downstream VERSION together after validation.
      matchFileNames: ["images/stable-diffusion-qwen/Dockerfile"],
      enabled: false,
    },
    {
      // The image installs these dependencies from the tagged source checkout.
      // Track Python updates in joejulian/unifi-cam-proxy instead.
      matchFileNames: [
        "images/unifi-cam-proxy/requirements.txt",
        "images/unifi-cam-proxy/pyproject.toml",
      ],
      enabled: false,
    },
    {
      matchDatasources: ["docker", "github-tags", "git-tags", "pypi", "golang-version", "custom.android-build-tools"],
      matchUpdateTypes: ["digest", "pin", "pinDigest", "patch", "minor"],
      automerge: true,
      addLabels: ["dependencies", "automerge"],
      groupName: "non-major dependencies",
      groupSlug: "non-major",
    },
    {
      matchManagers: ["dockerfile"],
      matchDatasources: ["docker"],
      pinDigests: true,
    },
  ],
  customDatasources: {
    "android-build-tools": {
      defaultRegistryUrlTemplate: "https://dl.google.com/android/repository/repository2-3.xml",
      format: "plain",
      transformTemplates: [
        '{"releases": [releases[$contains(version, /path="build-tools;[0-9]+\\.[0-9]+\\.[0-9]+"/)].{"version": $match(version, /build-tools;([0-9]+\\.[0-9]+\\.[0-9]+)"/).groups[0]}]}',
      ],
    },
  },
  customManagers: [
{
    "customType": "regex",
    "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
    ],
    "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s*go-version:\\s*[\\\"']?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s*go install [^\\s@]+@(?<currentValue>v[^\\s]+)"
    ]
},
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)images\\/[^/]+\\/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\nARG ANDROID_BUILD_TOOLS_VERSION=(?<currentValue>[^\\s]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\nARG FSYSLOG_VERSION=(?<currentValue>[^\\s]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+)\\nARG UNIFI_CAM_PROXY_REF=(?<currentValue>[^\\s]+)",
      ],
    },
  ],
}
